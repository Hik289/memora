# Copy to .env and fill in credentials locally. Never commit real credentials.
# Used by quickstart.py; benchmark YAML files have their own openai.api_type.
OPENAI_API_TYPE=openai
OPENAI_API_KEY=

# For Azure, set OPENAI_API_TYPE=azure and configure your endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
